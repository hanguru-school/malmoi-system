NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_INTRO_URL=http://localhost:3000/
NEXT_PUBLIC_LOGIN_URL=http://localhost:3000/login
NEXT_PUBLIC_LOGIN_NEXT_URL=http://localhost:3000/login/next
APP_BASE_URL=http://localhost:3000
NEXTAUTH_URL=https://portal.hanguru.school
MAIL_LINK_BASE_URL=https://portal.hanguru.school
AUTH_STORE_PATH=.data/auth-store.json
AUTH_TOKEN_TTL_MINUTES=15
AUTH_PASSWORD_RESET_TOKEN_TTL_MINUTES=30
AUTH_SESSION_TTL_HOURS=168
STUDENT_INITIAL_TOTAL_MINUTES=0
LESSON_MINUTES_DEDUCT_ON_NO_SHOW=false
LESSON_MINUTES_REFUND_ON_STUDENT_CANCEL=true
LESSON_MINUTES_REFUND_ON_ADMIN_CANCEL=true
RESERVATION_STUDENT_BOOKABLE_DAYS=365
NEXT_PUBLIC_LESSON_NOTE_BULK_RESULT_TTL_MINUTES=30
# 本番運用では true 推奨（.env.production.example 参照）。ローカルで V1 のみ試す場合は false。
NEXT_PUBLIC_USE_RESERVATION_UI_V2=false
NEXT_PUBLIC_USE_STUDENT_REGISTRATION_UI_V2=false
NEXT_PUBLIC_USE_ADMIN_STUDENTS_UI_V2=false
# 教室連絡先（領収・メールフッター表示。LINE 等は未使用）
CLASSROOM_CONTACT_EMAIL=office@example.com
MAIL_SEND_MODE=log
MAIL_FROM=no-reply@localhost
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
