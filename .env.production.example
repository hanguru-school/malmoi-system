# 本番デプロイ用の例。releases / current に載せる前にコピーして値を置き換える。
# NEXT_PUBLIC_* はビルド時に埋め込まれるため、変更後は必ず npm run build をやり直す。

NEXT_PUBLIC_BASE_URL=https://example.com
NEXT_PUBLIC_INTRO_URL=https://example.com/
NEXT_PUBLIC_LOGIN_URL=https://example.com/login
NEXT_PUBLIC_LOGIN_NEXT_URL=https://example.com/login/next
APP_BASE_URL=https://portal.hanguru.blog
NEXTAUTH_URL=https://portal.hanguru.blog
MAIL_LINK_BASE_URL=https://portal.hanguru.blog

AUTH_STORE_PATH=.data/auth-store.json

# 運用既定: 学生登録 UI V2・予約 UI V2（ロールバック時は false にして再ビルド）
NEXT_PUBLIC_USE_STUDENT_REGISTRATION_UI_V2=true
NEXT_PUBLIC_USE_RESERVATION_UI_V2=true
NEXT_PUBLIC_USE_ADMIN_STUDENTS_UI_V2=false

# 検証時は docs/operations-v2-verification-checklist.md を参照

# レッスン時間の消費タイミング（既定: 予約を「完了」にしたときのみ。従来の出欠ベースに戻す場合は false + 下記 true）
# LESSON_MINUTES_DEDUCT_ON_COMPLETION_ONLY=true
# LESSON_MINUTES_DEDUCT_ON_ATTENDED_LEGACY=false
