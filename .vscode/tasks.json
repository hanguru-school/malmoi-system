{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MalMoi: Push main + deploy (SSH)",
      "type": "shell",
      "command": "bash scripts/deploy-from-local.sh",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {}
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "MalMoi: Server deploy only (SSH, no git)",
      "type": "shell",
      "command": "bash scripts/deploy-server-only.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
