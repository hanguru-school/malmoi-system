# Copy to scripts/deploy.env (ignored by Git) and edit.

# --- 로컬 스크립트 (deploy-from-local.sh 등) ---
# SSH target for deployment (user@host or alias from ~/.ssh/config)
MALMOI_DEPLOY_SSH=malmoi_deploy@YOUR_SERVER_HOST

# --- GitHub Actions「Deploy production (manual)」(.github/workflows/deploy-production.yml) ---
# Repository Secrets: DEPLOY_HOST, DEPLOY_USER, DEPLOY_PORT, DEPLOY_APP_DIR, DEPLOY_SSH_KEY
# DEPLOY_APP_DIR 는 /srv/malmoi/apps/malmoi-integrated/current (Git clone 루트 = 실행 경로)
# (push 자동 배포 deploy-main.yml 은 MALMOI_REMOTE_DEPLOY_SCRIPT 기본값 동일)

# Optional: path to deploy script on server
# MALMOI_REMOTE_DEPLOY_SCRIPT=/srv/malmoi/apps/malmoi-integrated/current/deploy/deploy-prod.sh

# Optional: systemd unit name (default on server deploy-prod.sh)
# MALMOI_SYSTEMD_SERVICE=malmoi-web

# Optional: expected shared auth-store path (deploy-prod.sh log hints only)
# MALMOI_SHARED_AUTH_STORE=/srv/malmoi/shared/auth-store.json
