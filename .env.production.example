NEXT_PUBLIC_BASE_URL=https://your-domain.example
NEXT_PUBLIC_INTRO_URL=https://your-domain.example/
NEXT_PUBLIC_LOGIN_URL=https://your-domain.example/login
NEXT_PUBLIC_LOGIN_NEXT_URL=https://your-domain.example/login/next
APP_BASE_URL=https://your-domain.example
NEXTAUTH_URL=https://portal.hanguru.school
MAIL_LINK_BASE_URL=https://portal.hanguru.school
# 운영 권장: 앱 디렉터리 밖 고정 경로 (systemd Environment= 로도 동일 값 설정)
AUTH_STORE_PATH=/srv/malmoi/shared/auth-store.json
AUTH_TOKEN_TTL_MINUTES=15
AUTH_PASSWORD_RESET_TOKEN_TTL_MINUTES=30
AUTH_SESSION_TTL_HOURS=168
STUDENT_INITIAL_TOTAL_MINUTES=0
LESSON_MINUTES_DEDUCT_ON_NO_SHOW=false
LESSON_MINUTES_REFUND_ON_STUDENT_CANCEL=true
LESSON_MINUTES_REFUND_ON_ADMIN_CANCEL=true
RESERVATION_STUDENT_BOOKABLE_DAYS=365
NEXT_PUBLIC_LESSON_NOTE_BULK_RESULT_TTL_MINUTES=30
# 教室連絡先メール（LINE 等の外部チャットは使用しません）
CLASSROOM_CONTACT_EMAIL=office@your-domain.example
MAIL_SEND_MODE=smtp
MAIL_FROM=no-reply@your-domain.example
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
