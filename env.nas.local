# ========================================
# MalMoi 한국어 교실 - DXP2800 NAS 로컬 환경 변수
# AWS 서비스에서 로컬 서비스로 완전 이전
# ========================================

# ========================================
# 서버 환경 설정
# ========================================
NODE_ENV=production
NEXT_PUBLIC_ENVIRONMENT=production
NEXT_PUBLIC_APP_URL=http://192.168.0.50
NEXT_PUBLIC_PRODUCTION_URL=http://192.168.0.50

# Docker 환경 설정
PORT=3000
HOSTNAME=0.0.0.0

# ========================================
# 데이터베이스 설정 (로컬 PostgreSQL)
# ========================================
DATABASE_URL=postgresql://malmoi_admin:malmoi_admin_password_2024@localhost:5432/malmoi_system

# PostgreSQL 개별 설정
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=malmoi_system
DB_USERNAME=malmoi_admin
DB_PASSWORD=malmoi_admin_password_2024

# ========================================
# Redis 설정 (로컬)
# ========================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ========================================
# 파일 스토리지 설정 (로컬)
# ========================================
# AWS S3 대신 로컬 파일 시스템 사용
STORAGE_TYPE=local
UPLOAD_DIR=/mnt/malmoi-storage/app/uploads
STATIC_DIR=/mnt/malmoi-storage/app/static
MAX_FILE_SIZE=10485760  # 10MB

# ========================================
# 인증 설정 (로컬 세션 기반)
# ========================================
# Cognito 대신 로컬 인증 사용
AUTH_TYPE=local
SESSION_SECRET=malmoi_session_secret_2024_dxp2800
JWT_SECRET=malmoi_jwt_secret_2024_dxp2800

# NextAuth 설정
NEXTAUTH_SECRET=malmoi_nextauth_secret_2024_dxp2800
NEXTAUTH_URL=http://192.168.0.50

# ========================================
# 이메일 설정 (로컬 SMTP)
# ========================================
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=malmoi@localhost
SMTP_PASS=malmoi_smtp_password
SMTP_FROM=malmoi@localhost

# ========================================
# LINE 설정 (기존 유지 또는 비활성화)
# ========================================
# LINE 서비스는 외부 서비스이므로 기존 설정 유지하거나 비활성화
LINE_ENABLED=false
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CALLBACK_URL=http://192.168.0.50/api/auth/callback/line

# ========================================
# API 설정
# ========================================
API_BASE_URL=http://192.168.0.50/api
NEXT_PUBLIC_API_URL=http://192.168.0.50/api

# ========================================
# 기능 플래그
# ========================================
ENABLE_ANALYTICS=true
ENABLE_NOTIFICATIONS=true
ENABLE_BACKUP=true
ENABLE_CLOUD_SERVICES=false  # AWS 서비스 비활성화
NEXT_PUBLIC_DEV_MODE=false

# ========================================
# 로그 설정
# ========================================
LOG_LEVEL=info
LOG_DIR=/mnt/malmoi-storage/logs/app
LOG_FILE=malmoi.log

# ========================================
# 백업 설정
# ========================================
BACKUP_ENABLED=true
BACKUP_DIR=/mnt/malmoi-storage/backups
BACKUP_SCHEDULE=0 2 * * *  # 매일 새벽 2시
BACKUP_RETENTION_DAYS=30

# ========================================
# 모니터링 설정
# ========================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30
MONITORING_ENABLED=true

# ========================================
# 네트워크 설정
# ========================================
# 내부 네트워크 IP
INTERNAL_IP=192.168.0.50
EXTERNAL_IP=  # DDNS 설정 후 입력
DDNS_HOSTNAME=  # 예: malmoi.ddns.net

# ========================================
# SSL/TLS 설정 (향후 설정)
# ========================================
SSL_ENABLED=false
SSL_CERT_PATH=/etc/letsencrypt/live/malmoi.ddns.net/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/malmoi.ddns.net/privkey.pem

# ========================================
# 도메인 설정 (향후 app.hanguru.school 연결 시)
# ========================================
DOMAIN_ENABLED=false
DOMAIN_NAME=app.hanguru.school
DOMAIN_SSL_CERT=/etc/letsencrypt/live/app.hanguru.school/fullchain.pem
DOMAIN_SSL_KEY=/etc/letsencrypt/live/app.hanguru.school/privkey.pem

# ========================================
# 비활성화된 AWS 서비스들
# ========================================
# 다음 항목들은 로컬 환경에서 비활성화
AWS_ENABLED=false
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
# S3_REGION=
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# COGNITO_CLIENT_SECRET=

# ========================================
# 개발/디버그 설정
# ========================================
DEBUG_MODE=false
VERBOSE_LOGGING=false
PERFORMANCE_MONITORING=true